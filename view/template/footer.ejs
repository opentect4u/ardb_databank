<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<script>
    function exportTableToExcel(tableID, filename) {
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.table_to_sheet(document.getElementById(tableID));

        // Add a new row with the name "hello"
        XLSX.utils.sheet_add_aoa(ws, [['<%= user.user_data.msg[0].ardb_name %>', '', '', '', '', '', ''], ['Day Scroll Report', '', '', '', '', '', '', ''],
        ['Branch Name: <%= user.user_data.msg[0].branch_name %>', '', '', '', '', '', '', ''], ['Form Date: <%= typeof selected !== "undefined" ? selected.from_date : "" %>', '', '', '', '', '', '', ''],
        ['To Date: <%= typeof selected !== "undefined" ? selected.to_date : "" %>', '', '', '', ''], ['Sl. No.', 'Date', 'Supervisor Code', 'Account Type', 'Account No', 'Name', 'Amount']]);

        // Add the worksheet to the workbook
        XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');

        XLSX.writeFile(wb, filename);
        exit()

        const wbout = XLSX.write(ws, {
            bookType: 'xlsx',
            bookSST: true,
            type: 'binary'
        });

        function s2ab(s) {
            const buf = new ArrayBuffer(s.length);
            const view = new Uint8Array(buf);
            for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
            return buf;
        }

        const blob = new Blob([s2ab(wbout)], {
            type: 'application/octet-stream'
        });
        saveAs(blob, filename);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const downloadBtn = document.getElementById('downloadBtn');
        downloadBtn.addEventListener('click', function () {
            // Call the exportTableToExcel function, passing the table ID and desired filename
            exportTableToExcel('tableData', 'Day_Scroll_Report.xlsx');
        });
    });
</script>

<script>
    $(document).ready(function(){
        var ardb_id = $('#ardb_id').length > 0 ? $('#ardb_id').val() : null,
            branch_code = $('#branch_code').length > 0 ? $('#branch_code').val() : null;
        if(ardb_id > 0 && branch_code > 0){
            $('#branch_code').change();
        }else if(ardb_id > 0){
            $('#ardb_id').change();
        }
    })
    $('#ardb_id').on('change', function () {
        let ardb_id = $(this).val();
        const selected = {
            branch_code: '<%= typeof selected !== "undefined" ? selected.branch_code : "" %>',
        }
        $.ajax({
            type: "GET",
            url: "/admin/branch/get_brn_list_ajax",
            data: { ardb_id: ardb_id },
            success: function (response) {
                $('#branch_code').empty().append(`<option value="">Select Branch Name</option>`);
                response.msg.forEach(function (resData) {
                    let _selected = '';
                    if (selected.branch_code == resData.branch_code) _selected = 'selected'
                    $('#branch_code').append('<option value="' + resData.branch_code + '"'+ _selected +'>' + resData.branch_name + '</option>');
                    if(selected.branch_code > 0) $('#branch_code').change();
                });
            }
        });
    });
    $('#branch_code').on('change', function () {
        let branch_code = $(this).val(),
            ardb_id = $('#ardb_id').val();
        const enc_dt = window.btoa(JSON.stringify({ ardb_id, branch_code, id: 0 }));
        const selected = {
            supervisor_code: '<%= typeof selected !== "undefined" ? selected.supervisor_code : "" %>',
        }
        console.log(selected, '---------sup_code----------');
        
        $.ajax({
            type: "POST",
            url: "/admin/supervisor/get_sup_ajax",
            data: { enc_dt },
            success: function (response) {
                $('#supervisor_code').empty().append(`<option value="">Select Supervisor</option>`);
                response.msg.forEach(function (resData) {
                    let _selected = '';
                    if (selected.supervisor_code == resData.supervisor_code) _selected = 'selected'
                    $('#supervisor_code').append('<option value="' + resData.supervisor_code + '"'+ _selected +'>' + resData.user_id + ', ' + resData.supervisor_name + '</option>');
                });
            }
        });
    });
</script>


