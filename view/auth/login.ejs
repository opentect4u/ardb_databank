<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        background: #f8faf9;
    }

    .login-left {
        flex: 1;
        background: linear-gradient(135deg, rgba(27, 94, 32, 0.9), rgba(0, 51, 0, 0.95)), url('https://images.unsplash.com/photo-1523348837708-15d4a09cfac2?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        background-position: center;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 40px;
        text-align: center;
    }

    @media (min-width: 992px) {
        .login-left {
            display: flex;
        }
    }

    .login-logo-large {
        width: 150px;
        margin-bottom: 30px;
        filter: brightness(0) invert(1);
    }

    .login-left h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: white;
    }

    .login-left p {
        font-size: 1.1rem;
        opacity: 0.9;
        max-width: 400px;
    }

    .login-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        /* Ensure top is always reachable */
        align-items: center;
        padding: 40px 20px;
        overflow-y: auto;
    }

    .login-box {
        width: 100%;
        max-width: 550px;
        /* Slightly wider for better balance */
        background: white;
        padding: 40px;
        border-radius: 28px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.1);
        margin: auto 0;
        /* Centering behavior in scrollable flex */
        position: relative;
    }

    .mobile-logo {
        display: block;
        width: 100px;
        /* Smaller logo */
        margin: 0 auto 20px;
    }

    @media (min-width: 992px) {
        .mobile-logo {
            display: none;
        }
    }

    .login-box h2 {
        text-align: center;
        margin-bottom: 6px;
        font-weight: 700;
        color: var(--primary-dark);
        font-size: 1.5rem;
        /* Slightly smaller h2 */
    }

    .login-box p.subtitle {
        text-align: center;
        color: var(--text-muted);
        margin-bottom: 25px;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        color: #444;
        font-size: 0.9rem;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        transition: color 0.3s;
    }

    .input-wrapper input {
        width: 100%;
        padding: 16px 15px 16px 45px;
        height: 60px;
        border: 1px solid #e0e6ed;
        border-radius: 12px;
        outline: none;
        transition: all 0.3s;
        font-size: 16px;
        box-sizing: border-box;
    }

    .input-wrapper input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(39, 174, 96, 0.1);
    }

    .input-wrapper input:focus+i {
        color: var(--primary-green);
    }

    .login-btn {
        width: 100%;
        height: 60px;
        background: linear-gradient(135deg, #27ae60 0%, #1b5e20 100%);
        color: white;
        border: none;
        border-radius: 14px;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        margin-top: 15px;
        box-shadow: 0 8px 20px rgba(39, 174, 96, 0.3);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .login-btn:hover {
        background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(39, 174, 96, 0.4);
    }

    .login-btn:active {
        transform: translateY(-1px);
    }

    .footer-text {
        text-align: center;
        margin-top: 30px;
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.4;
    }

    .footer-text a {
        color: var(--primary-green);
        text-decoration: none;
        font-weight: 500;
    }

    /* Animation */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-box {
        animation: fadeInUp 0.8s ease-out;
    }
</style>

<div class="login-container">
    <div class="login-left">
        <img src="/images/logo_new.png" alt="ARDB Logo" class="login-logo-large">
        <h1>ARDB Daily Deposit Scheme</h1>
        <p style="font-size: 1.25rem; font-weight: 500; margin-bottom: 25px;">Empowering Rural Growth through Daily
            Savings.</p>
        <p style="opacity: 0.8;">Securely manage deposit collections, track loan demands, and streamline field agent
            activities in real-time.</p>
    </div>
    <div class="login-right">
        <div class="login-box">
            <img src="/images/logo_new.png" alt="ARDB Logo" class="mobile-logo">
            <h2>Authorized Access</h2>
            <p class="subtitle">Please enter your credentials to manage DDS collections.</p>

            <form action="/admin/login" method="post">
                <div class="form-group">
                    <label>User Name</label>
                    <div class="input-wrapper">
                        <i class="fa fa-user"></i>
                        <input type="text" placeholder="Enter your ID" name="email" value="" required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label>Security Password</label>
                    <div class="input-wrapper">
                        <i class="fa fa-lock"></i>
                        <input type="password" placeholder="••••••••" name="password" value="" required>
                    </div>
                </div>

                <button type="submit" class="login-btn">Secure Login <i class="fa fa-arrow-right ml-2"
                        style="font-size: 0.8rem; opacity: 0.8;"></i></button>
            </form>

            <div class="footer-text">
                <p>Support ARDB Rural Banking Mission<br>&copy; 2026 ARDB Bank - DDS Portal</p>
            </div>
        </div>
    </div>
</div>