<link rel="stylesheet" href="/css/upload_pctx_custom.css">

<div class="main-panel">
    <div class="content-wrapper">
        <div class="titleSec">
            <h2>UPLOAD PCTX</h2>
        </div>

        <div class="row">
            <!-- Left Side: Selection Form -->
            <div class="col-md-7">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="form-group col-12 progressbar_viw">
                                <div class="progress" role="progressbar" aria-label="Animated striped example"
                                    aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                    <div id="progressBar"
                                        class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                        style="width: 0%"></div>
                                </div>
                            </div>
                            <% if(user.user_data.msg[0].user_type !='R' ){ %>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="ardb_id">ARDB Name</label>
                                        <select name="ardb_id" class="form-control" id="ardb_id" required>
                                            <option value="">Select ARDB Name</option>
                                            <% ardb.msg.forEach(function(item2,index) { let _selected=''
                                                if(selected.ardb_id==item2.ardb_id) _selected='selected' %>
                                                <option value="<%=item2.ardb_id%>" <%=_selected %>>
                                                    <%=item2.ardb_name%>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="branch_code">Branch Name</label>
                                        <select name="branch_code" class="form-control" id="branch_code" required>
                                            <option value="">Select Branch Name</option>
                                            <% if(resDataBranch.length> 0){
                                                resDataBranch.forEach(dt => {
                                                let _selected = ''
                                                if(selected.branch_code == dt.branch_code) _selected = 'selected' %>
                                                <option value="<%= dt.branch_code %>" <%=_selected %>>
                                                    <%= dt.branch_name %>
                                                </option>
                                                <% }) } %>
                                        </select>
                                    </div>
                                </div>
                                <% }else{ %>
                                    <input type="hidden" name="ardb_id" id="ardb_id"
                                        value="<%= user.user_data.msg[0].ardb_id %>">
                                    <input type="hidden" name="branch_code" id="branch_code"
                                        value="<%= user.user_data.msg[0].branch_code %>">
                                    <% } %>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label for="supervisor_id">Supervisor</label>
                                                <select name="supervisor_id" class="form-control s2id"
                                                    id="supervisor_id">
                                                    <option value="">Select Supervisor</option>
                                                    <% data.forEach(function(item) { %>
                                                        <option value="<%= item.supervisor_id %>"
                                                            data-code="<%= item.supervisor_code %>">
                                                            <%= item.user_id %>, <%= item.supervisor_name %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                                <input type="hidden" id="sup_code">
                                            </div>
                                        </div>
                        </div>

                        <div class="agent_info_box agent_info" id="agent_info" style="display: none;">
                            <div class="row">
                                <div class="col-md-6 mt-2">
                                    <label class="text-muted small">Name</label>
                                    <p id="showAgentname"></p>
                                </div>
                                <div class="col-md-6 mt-2">
                                    <label class="text-muted small">Branch</label>
                                    <p id="showBranch"></p>
                                </div>
                                <div class="col-md-6 mt-2">
                                    <label class="text-muted small">Supervisor Code</label>
                                    <p id="showAgent"></p>
                                </div>
                                <div class="col-md-6 mt-2">
                                    <label class="text-muted small">Mobile No</label>
                                    <p id="showPhone_no"></p>
                                </div>
                                <% if(user.user_data.msg[0].sec_amt_type=='A' ){ %>
                                    <div class="col-md-6 mt-2">
                                        <label class="text-muted small">Account No</label>
                                        <p id="showAccountno"></p>
                                    </div>
                                    <% } %>
                                        <div class="col-md-6 mt-2">
                                            <label class="text-muted small">Allowable Collection Amount</label>
                                            <p id="maxAllColAmt"></p>
                                        </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h5 class="mb-3" style="color: var(--primary-dark);">Area Selection</h5>
                        <div id="dynamicRowsContainer">
                            <div class="dynamic-row" data-row-id="0">
                                <div class="row">
                                    <div class="form-group col-md-6">
                                        <label>Block Name</label>
                                        <select class="form-control block-select" required>
                                            <option value="">Select Block</option>
                                            <% block_list.forEach(function(item) { %>
                                                <option value="<%= item.block_id %>">
                                                    <%= item.block_name %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label>Service Area</label>
                                        <select class="form-control service-area-select s2id" multiple disabled
                                            required>
                                            <option value="">Select Service Area</option>
                                        </select>
                                    </div>
                                    <div class="form-group col-md-12">
                                        <label>Village Name</label>
                                        <div class="d-flex align-items-center">
                                            <select class="form-control village-select s2id" multiple disabled required>
                                                <option value="">Select Village</option>
                                            </select>
                                            <!-- <button type="button" class="add-row-btn" title="Add Row">
                                                <i class="fa fa-plus"></i> +
                                            </button> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="save-btn-container">
                            <button type="button" class="btn btn-primary" id="saveSelectedData">
                                <i class="fa fa-save"></i> Save Selection
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-block py-3" id="uploadButton" disabled>
                        POPULATE DATA
                    </button>
                </div>
            </div>

            <!-- Right Side: Preview Table -->
            <div class="col-md-5">
                <div class="preview-sticky-wrapper">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="mb-4" style="color: var(--primary-dark);">Saved Preview</h5>
                            <div class="preview-container">
                                <table class="table table-hover preview-table">
                                    <thead>
                                        <tr>
                                            <th>Block</th>
                                            <th>Service Area</th>
                                            <th>Village</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="previewTableBody">
                                        <tr>
                                            <td colspan="4" class="text-center placeholder-text">No data saved yet</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let rowCounter = 1;
    let savedData = [];

    $(document).ready(function () {
        $(".loader_div").hide();
        $("#uploadButton").attr("disabled", true);
        $(".progressbar_viw").hide();
        $("#progressBar").css("width", "0%");
    })

    // Helper to get row context
    function getRowContext(element) {
        return $(element).closest('.dynamic-row');
    }

    // Initialize Select2
    function initSelect2(element) {
        let placeholder = $(element).hasClass('service-area-select') ? "Select Service Area" : "Select Village";
        $(element).select2({
            placeholder: placeholder,
            allowClear: true,
            width: '100%'
        });

        $(element).on('select2:select', function (e) {
            if (e.params.data.id === 'all') {
                let allValues = $(this).find('option').not('[value="all"]').not('[value=""]').map(function () {
                    return this.value;
                }).get();
                $(this).val(allValues).trigger('change');
            }
        });
    }

    // Initial init
    initSelect2('.village-select');
    initSelect2('.service-area-select');
    $('#supervisor_id').select2({ width: '100%' }); // Also init supervisor if not already

    // Dynamic Row Logic
    $(document).on('click', '.add-row-btn', function () {
        const newRow = $('.dynamic-row').first().clone();
        newRow.attr('data-row-id', rowCounter++);

        // Remove Select2 specific elements/classes before re-init
        newRow.find('.select2-container').remove();
        newRow.find('select').removeClass('select2-hidden-accessible').removeAttr('data-select2-id').attr('id', '');

        newRow.find('select').each(function () {
            $(this).val('').prop('disabled', $(this).hasClass('service-area-select') || $(this).hasClass('village-select'));
            if ($(this).hasClass('village-select')) {
                $(this).empty().append('<option value="">Select Village</option>');
            }
        });
        // Replace plus icon with minus for secondary rows
        newRow.find('.add-row-btn').replaceWith('<button type="button" class="btn btn-sm btn-danger remove-row" style="position:static; margin-left:10px;">-</button>');
        $('#dynamicRowsContainer').append(newRow);

        // Re-init Select2 for the new row
        initSelect2(newRow.find('.village-select'));
    });

    $(document).on('click', '.remove-row', function () {
        $(this).closest('.dynamic-row').remove();
    });

    // ARDB & Branch Change logic
    $('#ardb_id').on('change', function () {
        let ardb_id = $(this).val();
        $.ajax({
            type: "GET",
            url: "/admin/branch/get_brn_list_ajax",
            data: { ardb_id: ardb_id },
            success: function (response) {
                $('#branch_code').empty().append(`<option value="">Select Branch Name</option>`);
                response.msg.forEach(function (resData) {
                    $('#branch_code').append('<option value="' + resData.branch_code + '">' + resData.branch_name + '</option>');
                });
            }
        });
    });

    $("#supervisor_id").change(function () {
        const ardb_id = $('#ardb_id').val(),
            branch_code = $('#branch_code').val(),
            sup_id = $(this).val();

        if (!sup_id) {
            $(".agent_info").hide();
            return;
        }

        const req_data = window.btoa(JSON.stringify({ ardb_id, branch_code, id: sup_id }));

        $.ajax({
            type: "POST",
            url: "/admin/supervisor/get_sup_ajax",
            data: { enc_dt: req_data },
            success: function (response) {
                $(".agent_info").show();
                $("#showAgentname").text(response.msg[0].supervisor_name);
                $("#showBranch").text(response.msg[0].branch_name);
                $("#showAgent").text(response.msg[0].user_id);
                $("#showPhone_no").text(response.msg[0].phone_no);
                $("#maxAllColAmt").text(response.msg[0].max_amt);

                $('#sup_code').val(response.msg[0].user_id)
                    <% if (user.user_data.msg[0].sec_amt_type == 'A') { %>
                    if (response.msg[0].account_no) {
                            $("#showAccountno").text(response.msg[0].account_no);
                        }
                <% } %>
                    $("#uploadButton").attr("disabled", false);
            }
        });
    });

    // Block/Service/Village Cascading for Dynamic Rows
    $(document).on('change', '.block-select', function () {
        const block_id = $(this).val();
        const ardb_id = $('#ardb_id').val();
        const $row = getRowContext(this);
        const $serviceSelect = $row.find('.service-area-select');
        const $villSelect = $row.find('.village-select');

        $serviceSelect.empty().append('<option value="">Select Service Area</option>').prop('disabled', true);
        $villSelect.empty().append('<option value="">Select Village</option>').prop('disabled', true);

        if (block_id) {
            $.ajax({
                type: "GET",
                url: "/admin/common/get_service_area_list",
                data: { ardb_id, block_id },
                success: function (response) {
                    $serviceSelect.empty().append('<option value="all">Select All</option>');
                    response.msg.forEach(function (resData) {
                        $serviceSelect.append('<option value="' + resData.service_area_id + '">' + resData.service_area_name + '</option>');
                    });
                    $serviceSelect.prop('disabled', false);
                    $serviceSelect.trigger('change');
                }
            });
        }
    });

    $(document).on('change', '.service-area-select', function () {
        const service_area_id = $(this).val(); // This will be an array now
        const ardb_id = $('#ardb_id').val();
        const block_id = getRowContext(this).find('.block-select').val();
        const $row = getRowContext(this);
        const $villSelect = $row.find('.village-select');

        $villSelect.empty().append('<option value="">Select Village</option>').prop('disabled', true);

        if (service_area_id && service_area_id.length > 0) {
            $.ajax({
                type: "POST",
                url: "/admin/common/get_village_list",
                data: { ardb_id, block_id, service_area_id },
                success: function (response) {
                    $villSelect.empty().append('<option value="all">Select All</option>');
                    response.msg.forEach(function (resData) {
                        $villSelect.append('<option value="' + resData.vill_id + '" data-sa-id="' + resData.service_area_id + '" data-sa-name="' + resData.service_area_name + '">' + resData.vill_name + '</option>');
                    });
                    $villSelect.prop('disabled', false);
                    $villSelect.trigger('change'); // Notify Select2
                }
            });
        }
    });

    // Save Selection Logic
    $('#saveSelectedData').on('click', function () {
        let valid = true;
        let batchData = [];

        $('.dynamic-row').each(function () {
            const block = $(this).find('.block-select');
            const service = $(this).find('.service-area-select');
            const village = $(this).find('.village-select');

            if (!block.val() || !service.val() || !village.val() || village.val().length === 0) {
                valid = false;
                alert("Please complete selection in all rows before saving.");
                return false;
            }

            village.find('option:selected').each(function () {
                if ($(this).val() === 'all') return;

                let sa_id = $(this).data('sa-id');
                let sa_name = $(this).data('sa-name');

                batchData.push({
                    block_id: block.val(),
                    block_name: block.find('option:selected').text().trim(),
                    service_area_id: sa_id,
                    service_area_name: sa_name,
                    vill_id: $(this).val(),
                    vill_name: $(this).text().trim()
                });
            });
        });

        if (valid) {
            savedData = [...savedData, ...batchData];
            updatePreviewTable();
            // Reset dynamic rows to 1
            $('#dynamicRowsContainer').find('.dynamic-row:not(:first)').remove();
            const firstRow = $('.dynamic-row').first();
            firstRow.find('.block-select').val('');
            firstRow.find('.service-area-select').empty().append('<option value="">Select Service Area</option>').prop('disabled', true);
            firstRow.find('.village-select').empty().append('<option value="">Select Village</option>').prop('disabled', true).trigger('change');
        }
    });

    function updatePreviewTable() {
        const $tbody = $('#previewTableBody');
        $tbody.empty();

        if (savedData.length === 0) {
            $tbody.append('<tr><td colspan="4" class="text-center placeholder-text">No data saved yet</td></tr>');
            return;
        }

        savedData.forEach((item, index) => {
            $tbody.append(`
                <tr>
                    <td>${item.block_name}</td>
                    <td>${item.service_area_name}</td>
                    <td>${item.vill_name}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSavedItem(${index})">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
        });
    }

    window.removeSavedItem = function (index) {
        savedData.splice(index, 1);
        updatePreviewTable();
    };

    $('#uploadButton').on('click', function () {
        $("#uploadButton").attr('disabled', true);
        $(".loader_div").show();
        if (savedData.length === 0) {
            alert("Please save some selections before populating data.");
            return;
        }
        console.log("Final Data to Process:", savedData);
        let supervisor_code = $("#sup_code").val();
        // Add your logic to send savedData to server if needed
        $.ajax({
            type: "POST",
            url: "/admin/operation/check_sync_data_ajax",
            data: JSON.stringify({ supervisor_code }),
            contentType: "application/json",
            success: function (response) {
                console.log(response);

                if (response) {

                    // alert("Data populated successfully (check console for output)");
                    $.ajax({
                        type: "POST",
                        url: "/admin/operation/check_and_collection_ajax",
                        data: JSON.stringify({ supervisor_code }),
                        contentType: "application/json",
                        success: function (response) {
                            console.log(response);
                            if (response > 0) {
                                $(".loader_div").hide();
                                //alert("Not terminating in collection, an agent");
                                Swal.fire({
                                    icon: "error",
                                    title: "Oops...",
                                    text: "Data already uploaded.Collection in progress ! !",
                                });
                                $("#uploadButton").attr('disabled', false);
                            } else {
                                delete_agent_oldData(supervisor_code)
                            }
                        },
                        error: function (error) {
                            console.log(error);
                            $("#uploadButton").attr('disabled', false);
                        },
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: "Previous data has not been posted in Banking Application!!",
                    });
                    $(".loader_div").hide();
                    $("#uploadButton").attr('disabled', false);
                }
            },
            error: function (error) {
                console.log(error);
            },
        });

        function delete_agent_oldData(supervisor_code) {
            $.ajax({
                type: "POST",
                url: "/admin/operation/del_all_pctx_file_data_ajax",
                data: { supervisor_code },
                success: function (response) {
                    fitchDatabase(supervisor_code);
                    console.log(response);
                },
                error: function (error) {
                    console.log(error);
                },
            });
        }

        function fitchDatabase(supervisor_code) {
            $.ajax({
                type: "POST",
                url: "/admin/operation/fetchdata_to_server_ajax",
                data: { supervisor_code, savedData },
                success: function (response) {
                    $(".loader_div").hide();
                    console.log(response);
                    if (response.suc > 0)
                        insert_agent_trans()
                    Swal.fire("SUCCESS", "Data upload Successful", "success").then((result) => {

                    });
                    $("#uploadButton").attr('disabled', false);
                },
                error: function (error) {
                    console.log(error);
                    $("#agent2_info").hide();

                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: "Data Not uploaded.Collection failed !",
                    });
                    $("#uploadButton").attr('disabled', false);
                },
            });
        }
        function insert_agent_trans() {
            $.ajax({
                type: "POST",
                url: "/admin/operation/create_supervisor_trans_ajax",
                data: { supervisor_code },
                success: function (response) {
                    console.log(response);
                },
                error: function (error) {
                    console.log(error);
                },
            });
        }
    });

</script>