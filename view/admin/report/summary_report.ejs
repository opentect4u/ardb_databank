<div class="main-panel">
    <div class="content-wrapper">
        <div class="card">
            <div class="card-body">
                <div class="titleSec">
                    <!-- <button type="button" class="btn btn-primary">Export as CSV</button> -->
                    <h2>Day scroll report</h2>
                </div>
                <!-- <input type="file" name="myFile" class="" id="pctxFile"> -->
                <form action="/admin/report/summary_report" method="post">
                    <div class="row">
                        <div class="form-group col-6">
                            <label for="from_date">Form Date:</label>
                            <input type="date" name="from_date" class="form-control" value="<%= selected.from_date %>" required />
                        </div>

                        <div class="form-group col-6">
                            <label for="to_date">To Date:</label>
                            <input type="date" name="to_date" class="form-control" value="<%= selected.to_date %>" required />
                        </div>

                    </div>
                    <%- include('../common/pageHeader.ejs') %>
                    <div class="row">
                        <div class="form-group col-12">
                            <input type="submit" value="SUBMIT" class="btn btn-primary btn-block" id="downloadButton" />
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <% if(request == 'POST'){ %>
            <div class="card" id="">
                <div class="card-body" id="tableData">
                    <div class="titleSec">
                        <div class="row">
                            <div class="col-12">
                                <h4 style="text-align: center;">
                                    <%= user.user_data.msg[0].ardb_name %>
                                </h4>
                                <h5 style="text-align: center;">
                                    <%= user.user_data.msg[0].ardb_address %>
                                </h5>
                                <h6 style="text-align: center;">Day Scroll Report Form Date: <%= dateFormat(selected.from_date, 'dd/mm/yyyy') %> To Date: <%= dateFormat(selected.to_date, 'dd/mm/yyyy') %>
                                </h6>
                            </div>
                            <div class="col-6">
                                <h6 style="text-align: left;">Branch Name: <%= user.user_data.msg[0].branch_code %>
                                </h6>
                            </div>
                            <div class="col-6">
                                <h6 style="text-align: right;">Date: <%= dateFormat(new Date(), 'dd/mm/yyyy') %>
                                </h6>
                            </div>
                        </div>
                    </div>
                    <!-- <input type="file" name="myFile" class="" id="pctxFile"> -->
                    <div id="printTag">
                        <style>
                            @media print {
                                .print-inline {
                                    display: flex;
                                    justify-content: space-between;
                                }
                            }
                        </style>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sl. No.</th>
                                    <th>Supervisor Code</th>
                                    <th>Supervisor Trans No</th>
                                    <th>Send Date</th>
                                    <th>Received Date</th>
                                    <th>Status</th>
                                    <th>Deposit Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                        
                                <% var total_amount=0.0; %>

                                <% if(repo_dt && repo_dt.length > 0){ %>

                                <% repo_dt.forEach(function(item,index) {
                                    total_amount+=item.deposit_amount %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td>
                                            <%= item.supervisor_code %>
                                        </td>
                                        <td>
                                            <%= item.supervisor_trans_no %>
                                        </td>
                                        <td>
                                            <%= dateFormat(item.send_date, 'dd/mm/yyyy') %>
                                        </td>
                                        <td>
                                            <%= dateFormat(item.received_date, 'dd/mm/yyyy') %>
                                        </td>
                                        <td>
                                            <%= (item.end_flag=='Y' )?"End":'Start' %>
                                        </td>
                                        <td>
                                            <%= item.deposit_amount %>
                                        </td>
                        
                                    </tr>
                                    <% }) %>
                        
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td>Total</td>
                                            <td>
                                                <%=total_amount%>
                                            </td>
                        
                                        </tr>
                                        <% } else { %>

                                        <tr>
                                            <td colspan="7" style="text-align:center;color:red;">
                                                No Data Found
                                            </td>
                                        </tr>
                                        <% } %>
                        
                            </tbody>
                        </table>
                    </div>
            
            
                    <div class="mt-2" id="btnclass">
                        <div class="row">
                            <div class="col-sm-12">
                                <button type="button" class="btn btn-primary" id="printMe" onclick="printDiv()">
                                    Print
                                </button>
                                <button id="downloadBtn" class="btn btn-primary">Download Excel</button>
                            </div>
                        </div>
                    </div>
            
                </div>
            </div>
        <% } %>
    </div>
</div>