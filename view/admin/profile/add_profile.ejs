<div class="main-panel">
  <div class="content-wrapper">
    <div class="card col-12 shadow-sm">
      <div class="card-body">

        <!-- Profile Header -->
        <div class="row mb-4 align-items-center">

          <div class="col-md-10">
            <h4 class="mb-0"><i class="fa fa-vcard-o"></i> <span><%= title %></span></h4>
          </div>
        </div>

        <hr/>

        <!-- Profile Details -->
        <div class="row profile-details">

          <% if(user.user_data.msg[0].user_type == 'R'){ %>

          <div class="col-md-4 mb-3">
            <label>ARDB Name</label>
            <div class="profile-value"><%= data.ardb_name %></div>
          </div>

          <div class="col-md-4 mb-3">
          <label>Branch Name</label>
          <div class="profile-value"><%= data.branch_name %></div>
          </div>

          <div class="col-md-4 mb-3">
          <label>Branch Contact Person</label>
          <div class="profile-value"><%= data.branch_contact %></div>
          </div>

          <div class="col-md-4 mb-3">
          <label>Branch Phone No</label>
          <div class="profile-value"><%= data.branch_phone %></div>
          </div>

          <div class="col-md-4 mb-3">
          <label>Branch Email</label>
          <div class="profile-value"><%= data.branch_email %></div>
          </div>

          <div class="col-md-12 mb-3">
            <label>Branch Address</label>
            <div class="profile-value address-box">
              <%= data.branch_address %>
            </div>
          </div>

          <% } %>

          <% if(user.user_data.msg[0].user_type == 'B'){ %>
          <div class="col-md-4 mb-3">
            <label>Contact Person</label>
            <div class="profile-value"><%= data.ardb_contact %></div>
          </div>

          <div class="col-md-4 mb-3">
            <label>Mobile No</label>
            <div class="profile-value"><%= data.ardb_phone %></div>
          </div>

          <div class="col-md-4 mb-3">
            <label>Email</label>
            <div class="profile-value"><%= data.ardb_email %></div>
          </div>

          <div class="col-md-4 mb-3">
            <label>Max User</label>
            <div class="profile-value"><%= data.max_user %></div>
          </div>

          <div class="col-md-12 mb-3">
            <label>Address</label>
            <div class="profile-value address-box">
              <%= data.ardb_address %>
            </div>
          </div>
           <% } %>

        </div>

      </div>
    </div>
  </div>
</div>

<style>
    .profile-details label {
  font-weight: 600;
  color: #6c757d;
  font-size: 13px;
  margin-bottom: 3px;
}

.profile-value {
  background: #f8f9fa;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 14px;
  border: 1px solid #e3e6f0;
}

.address-box {
  min-height: 60px;
}

.profile-img img {
  object-fit: cover;
}

</style>