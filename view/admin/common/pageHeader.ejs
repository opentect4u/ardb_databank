<div class="row">
    <% if(user.user_data.msg[0].user_type !='R'){
        if(user.user_data.msg[0].user_type !='B'){ %>
        <div class="col-md-6">
            <div class="form-group">
                <label for="ardb_id">ARDB Name</label>
                <select name="ardb_id" class="form-control" id="ardb_id" required>
                    <option value="">Select ARDB Name</option>
                    <% ardb.msg.forEach(function(item2,index) { 
                        let _selected='';
                        if(selected.ardb_id==item2.ardb_id) _selected='selected' %>
                        <option value="<%= item2.ardb_id %>" <%= _selected %>>
                            <%=item2.ardb_name%>
                        </option>
                        <% }); %>
                </select>
            </div>
        </div>
        <% }else{ %>
            <input type="hidden" name="ardb_id" id="ardb_id" value="<%= user.user_data.msg[0].ardb_id %>">
        <% } %>

        <div class="col-md-6">
            <div class="form-group">
                <label for="branch_code">Branch Name</label>
                <select name="branch_code" class="form-control" id="branch_code" required>
                    <option value="">Select Branch Name</option>
                </select>
            </div>
        </div>
    <% }else{ %>
        <input type="hidden" name="ardb_id" id="ardb_id" value="<%= user.user_data.msg[0].ardb_id %>">
        <input type="hidden" name="branch_code" id="branch_code" value="<%= user.user_data.msg[0].branch_code %>">
    <% } %>
    <div class="col-md-6">
        <div class="form-group">
            <label for="supervisor_code">Supervisor</label>
            <select name="supervisor_code" class="form-control s2id" id="supervisor_code">
                <option value="">Select Supervisor</option>
            </select>
            <input type="hidden" id="sup_code">
        </div>
    </div>
</div>