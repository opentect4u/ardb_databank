<div class="main-panel">
  <div class="content-wrapper">
    <div class="card col-12">
      <div class="card-body">
        <div class="titleSec">
          <button type="button" class="btn btn-info float-right" onclick="editArdb('<%= selected.ardb_id %>', 'Y')" id="myBtn">Add</button>
          <h2>ARDB Details</h2>
        </div>
        <div class="row">
                    <div class="form-group col-2">
                        <input type="radio" name="status" id="active" value="Y" <%= selected.flag == 'Y' ? 'checked' : '' %>>
                        <label for="active">Active ARDB</label>
                    </div>

                    <div class="form-group col-2">
                        <input type="radio" name="status" id="inactive" value="N" <%= selected.flag == 'N' ? 'checked' : '' %>>
                        <label for="inactive">Inactive ARDB</label>
                    </div>


                </div>
        <table id="example2" class="table table-striped table-bordered" style="width:100%">
          <thead>
            <tr>
              <th>Sl. No.</th>
              <th>ARDB Name</th>
              <th>Contact Person</th>
              <th>Phone NO</th>
              <th>Max User</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if(data.length > 0){
                 let i = 1
              data.forEach(item => { %>
                <tr>
                    <td>
                        <%=i %>
                    </td>
                    <td>
                        <%= item.ardb_name %>
                    </td>
                    <td>
                        <%= item.contact_person %>
                    </td>
                    <td>
                        <%= item.phone_no %>
                    </td>
                    <td>
                        <%= item.max_user %>
                    </td>
                    <td>
                       <button type="button" class="btn btn-info" onclick="editArdb('<%= item.ardb_id %>', '<%= item.active_flag %>')">Edit</button>
                    </td>
                </tr>
               <% i++; })}else{ %>
                    <tr>
                        <td colspan="6" class="text-center text-danger">
                            No Data Found
                        </td>
                    </tr>
                <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
      $('input[name="status"]').on('change', function () {
        let data = { flag: $(this).val() }
        routToNextPage('/admin/ardb', JSON.stringify(data), true)
    })

      function editArdb(ardb_id, flag){
        let data = { ardb_id, flag }
        routToNextPage('/admin/ardb/edit', JSON.stringify(data), true)
    }
</script>