              <i class="fa fa-eye"></i>
            </span>
            </div>
             </div>
            </div>
            <% } %>

            <div class="form-group col-4">
              <label for="start">ARDB start Date & Time:</label>
              <input type="datetime-local" name="start" class="form-control" id="start" style="background-color: bisque;" value="" readonly />
            </div> -->


            <div class="form-group col-4 mt-3">
              <label>Active flag:<% if(data.ardb_id == 0 || data.ardb_id == undefined || data.ardb_id == null){ %><span style="color: rgb(182, 5, 5);">*</span><% } %></label>
            
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  name="active_flag"
                  class="form-check-input"
                  id="active_option"
                  value="Y" <%= data.active_flag == 'Y' ? 'Checked' : '' %>
                />
                <label class="form-check-label" for="active_option">Active</label>
              </div>
            
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  name="active_flag"
                  class="form-check-input"
                  id="inactive_option"
                  value="N" <%= data.active_flag == 'N' ? 'Checked' : '' %>
                />
                <label class="form-check-label" for="inactive_option">Inactive</label>
              </div>
            </div>

            <div class="form-group col-4 mt-3">
              <label>After Maturity Collection:<% if(data.ardb_id == 0 || data.ardb_id == undefined || data.ardb_id == null){ %><span style="color: rgb(182, 5, 5);">*</span><% } %></label>
            
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  name="after_maturity_coll"
                  class="form-check-input"
                  id="maturity_active_option"
                  value="Y" <%= data.after_maturity_coll == 'Y' ? 'Checked' : '' %>
                />
                <label class="form-check-label" for="maturity_active_option">Yes</label>
              </div>
            
              <div class="form-check form-check-inline">
                <input
                  type="radio"
                  name="after_maturity_coll"
                  class="form-check-input"
                  id="maturity_inactive_option"
                  value="N" <%= data.after_maturity_coll == 'N' ? 'Checked' : '' %>
                />
                <label class="form-check-label" for="maturity_inactive_option">No</label>
              </div>
            </div>

            <div class="form-group col-12 mt-3">
              <label for="ardb_address">ARDB Address:<% if(data.ardb_id == 0 || data.ardb_id == undefined || data.ardb_id == null){ %><span style="color: rgb(182, 5, 5);">*</span><% } %></label>
              <textarea  name="ardb_address"
              id="ardb_address"
              class="form-control"
              placeholder="Enter ardb address here..."
              cols="30" rows="3"><%= data.ardb_address %></textarea>
            </div>

            <div class="form-group col-3 center">
              <input
                type="submit" value="SUBMIT" class="btn btn-primary btn-block" style="margin-left: 25vw;"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>

document.addEventListener("DOMContentLoaded", function(){

   let now = new Date();

   // Format to YYYY-MM-DDTHH:MM
   let formatted =
       now.getFullYear() + "-" +
       String(now.getMonth()+1).padStart(2,'0') + "-" +
       String(now.getDate()).padStart(2,'0') + "T" +
       String(now.getHours()).padStart(2,'0') + ":" +
       String(now.getMinutes()).padStart(2,'0');

   document.getElementById("start").value = formatted;

});

function togglePassword(fieldId, el){

    let input = document.getElementById(fieldId);
    let icon = el.querySelector("i");

    if(input.type === "password"){
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
    } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
    }
}

  // $(document).ready(function () {
